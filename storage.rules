rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    function hasImageExtension(fileName) {
      return fileName.lower().matches('.*[.](jpg|jpeg|png|webp|heic)$');
    }

    function hasVideoExtension(fileName) {
      return fileName.lower().matches('.*[.](mp4|mov|webm|hevc)$');
    }

    function isImageContentType(contentType) {
      return contentType in [
        'image/jpeg',
        'image/png',
        'image/webp',
        'image/heic',
        'image/heif',
      ];
    }

    function isVideoContentType(contentType) {
      return contentType in [
        'video/mp4',
        'video/quicktime',
        'video/webm',
        'video/hevc',
      ];
    }

    function isAllowedImageUpload(fileName) {
      return hasImageExtension(fileName)
        && isImageContentType(request.resource.contentType)
        && request.resource.size <= 50 * 1024 * 1024;
    }

    function isAllowedVideoUpload(fileName) {
      return hasVideoExtension(fileName)
        && isVideoContentType(request.resource.contentType)
        && request.resource.size <= 4 * 1024 * 1024 * 1024;
    }

    function isAllowedStoredImage(fileName) {
      return hasImageExtension(fileName)
        && isImageContentType(resource.contentType)
        && resource.size <= 50 * 1024 * 1024;
    }

    function isAllowedStoredVideo(fileName) {
      return hasVideoExtension(fileName)
        && isVideoContentType(resource.contentType)
        && resource.size <= 4 * 1024 * 1024 * 1024;
    }

    function isAllowedThumbnailUpload(fileName) {
      return fileName.lower().matches('.*[.]webp$')
        && request.resource.contentType == 'image/webp'
        && request.resource.size <= 2 * 1024 * 1024;
    }

    function isAllowedStoredThumbnail(fileName) {
      return fileName.lower().matches('.*[.]webp$')
        && resource.contentType == 'image/webp'
        && resource.size <= 2 * 1024 * 1024;
    }

    match /guest-uploads/thumbnails/{fileName} {
      allow get, list: if isSignedIn()
        && (isAllowedStoredThumbnail(fileName) || isAdmin());
      allow create: if isSignedIn() && isAllowedThumbnailUpload(fileName);
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /guest-uploads/{fileName} {
      allow get, list: if isSignedIn()
        && (isAllowedStoredImage(fileName) || isAllowedStoredVideo(fileName) || isAdmin());
      allow create: if isSignedIn()
        && (isAllowedImageUpload(fileName) || isAllowedVideoUpload(fileName));
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
